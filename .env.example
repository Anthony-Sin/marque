# Copy to .env and fill in. Never commit .env.

# TensorMux — OpenAI-compatible chat completions (text/agentic features)
TENSOR_BASE_URL=https://api.tensormux.com/v1
TENSOR_API_KEY=tmx_your_key_here
TENSOR_MODEL=glm-4-7-flash

# Google Gemini API — image generation/edits + Veo video
# Single key works; add GEMINI_API_KEYS as a comma-separated pool for
# rotation/retry on 429s (keys are tried in order, failures back off).
GEMINI_API_KEY=your_gemini_key
# GEMINI_API_KEYS=key1,key2,key3,key4,key5
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-lite-generate-preview

# Local image model — server/scripts/localgen.py keeps SDXL-Turbo warm on GPU.
# Start it with the torch venv (system python lacks torch):
#   LOCALGEN_MODEL=stabilityai/sdxl-turbo .venv-gen/bin/python3 server/scripts/localgen.py   # serves :8807
# LOCALGEN_PROVIDER: off | local-first (local, then Gemini/Pollinations) | local-only | fallback
# LOCALGEN_MODEL: HF id of a turbo-distilled text2img model (default stabilityai/sdxl-turbo;
#   stabilityai/sd-turbo still works for a lighter card).
# Optional knobs: LOCALGEN_PORT, LOCALGEN_BASE (default 512), LOCALGEN_STEPS (default 4,
#   clamped 1-8), LOCALGEN_MAXPX (request clamp, default 1024),
#   LOCALGEN_OFFLOAD=auto|model|sequential|none (auto = model cpu-offload, falls back
#   to sequential cpu-offload if a full-size warmup OOMs).
LOCALGEN_URL=http://127.0.0.1:8807
LOCALGEN_PROVIDER=off
# LOCALGEN_MODEL=stabilityai/sdxl-turbo

# Qloo Taste AI — cultural affinity graph (hackathon base URL only)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Server
PORT=8787
DATA_DIR=./data
